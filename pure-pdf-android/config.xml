<?xml version='1.0' encoding='utf-8'?>
<widget id="com.purepdf.viewer" version="1.0.0" xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0">
    <name>Pure PDF Viewer</name>
    <description>
        Einfacher und schneller PDF Viewer für Android. Öffne, lese und durchsuche PDF-Dateien mit Leichtigkeit.
    </description>
    <author email="support@purepdf.app" href="https://purepdf.app">
        Pure PDF Team
    </author>

    <content src="index.html" />

    <access origin="*" />

    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />
    <allow-intent href="tel:*" />
    <allow-intent href="sms:*" />
    <allow-intent href="mailto:*" />
    <allow-intent href="geo:*" />

    <platform name="android">
        <allow-intent href="market:*" />

        <!-- Icons -->
        <icon density="ldpi" src="assets/icon-ldpi.png" />
        <icon density="mdpi" src="assets/icon-mdpi.png" />
        <icon density="hdpi" src="assets/icon-hdpi.png" />
        <icon density="xhdpi" src="assets/icon-xhdpi.png" />
        <icon density="xxhdpi" src="assets/icon-xxhdpi.png" />
        <icon density="xxxhdpi" src="assets/icon-xxxhdpi.png" />

        <!-- Splash Screens -->
        <splash density="land-ldpi" src="assets/splash-land-ldpi.png" />
        <splash density="land-mdpi" src="assets/splash-land-mdpi.png" />
        <splash density="land-hdpi" src="assets/splash-land-hdpi.png" />
        <splash density="land-xhdpi" src="assets/splash-land-xhdpi.png" />
        <splash density="land-xxhdpi" src="assets/splash-land-xxhdpi.png" />
        <splash density="land-xxxhdpi" src="assets/splash-land-xxxhdpi.png" />
        <splash density="port-ldpi" src="assets/splash-port-ldpi.png" />
        <splash density="port-mdpi" src="assets/splash-port-mdpi.png" />
        <splash density="port-hdpi" src="assets/splash-port-hdpi.png" />
        <splash density="port-xhdpi" src="assets/splash-port-xhdpi.png" />
        <splash density="port-xxhdpi" src="assets/splash-port-xxhdpi.png" />
        <splash density="port-xxxhdpi" src="assets/splash-port-xxxhdpi.png" />

        <!-- App configuration -->
        <preference name="android-minSdkVersion" value="24" />
        <preference name="android-targetSdkVersion" value="33" />
        <preference name="android-compileSdkVersion" value="33" />

        <!-- File access -->
        <config-file parent="/*" target="AndroidManifest.xml">
            <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
            <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
        </config-file>

        <!-- File Provider for Android 7+ -->
        <resource-file src="assets/file_provider_paths.xml" target="app/src/main/res/xml/file_provider_paths.xml" />
    </platform>

    <!-- Preferences -->
    <preference name="DisallowOverscroll" value="true" />
    <preference name="BackgroundColor" value="0xff2c3e50" />
    <preference name="Orientation" value="default" />
    <preference name="Fullscreen" value="false" />
    <preference name="SplashScreenDelay" value="3000" />
    <preference name="FadeSplashScreenDuration" value="300" />
    <preference name="ShowSplashScreenSpinner" value="false" />
    <preference name="SplashMaintainAspectRatio" value="true" />
    <preference name="SplashShowOnlyFirstTime" value="false" />

    <!-- Plugins -->
    <plugin name="cordova-plugin-file" spec="^8.0.0" />
    <plugin name="cordova-plugin-file-opener2" spec="^4.0.0" />
    <plugin name="cordova-plugin-chooser" spec="^1.3.2" />
    <plugin name="cordova-plugin-splashscreen" spec="^6.0.2" />
    <plugin name="cordova-plugin-statusbar" spec="^4.0.0" />
    <plugin name="cordova-plugin-whitelist" spec="^1.3.5" />

    <!-- Allow navigation -->
    <allow-navigation href="*" />
</widget>
