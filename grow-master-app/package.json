{
  "name": "grow-master-app",
  "version": "1.0.0",
  "description": "KI-gestützter Pflanzen-Assistent mit Chatbot und Bildanalyse",
  "main": "www/index.html",
  "scripts": {
    "android": "cordova run android",
    "ios": "cordova run ios",
    "build:android": "cordova build android --release",
    "build:ios": "cordova build ios --release",
    "serve": "python3 -m http.server 8000 --directory www"
  },
  "keywords": [
    "plants",
    "gardening",
    "ai",
    "chatbot",
    "plant-care"
  ],
  "author": "Ai Storm Create",
  "license": "MIT",
  "cordova": {
    "platforms": [
      "android",
      "ios"
    ],
    "plugins": {
      "cordova-plugin-camera": {},
      "cordova-plugin-file": {},
      "cordova-plugin-statusbar": {}
    }
  },
  "devDependencies": {
    "cordova": "^12.0.0",
    "cordova-android": "^12.0.0",
    "cordova-ios": "^7.0.0"
  },
  "dependencies": {
    "cordova-plugin-camera": "^6.0.0",
    "cordova-plugin-file": "^8.0.0",
    "cordova-plugin-statusbar": "^4.0.0"
  }
}
