// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// User Model
model User {
  id        String     @id @default(cuid())
  email     String     @unique
  username  String     @unique
  password  String     // hashed with bcrypt
  name      String?
  avatar    String?    // URL to avatar image
  bio       String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  // Relations
  projects  Project[]
  sessions  Session[]
  costs     CostLog[]
  quotas    UserQuota?
  subscription Subscription?
  billing   Billing[]
  apiKeys   APIKey[]
  notifications NotificationSettings?
  analytics ProjectAnalytics[]

  @@index([email])
}

// User Quota/Limits
model UserQuota {
  id                    String   @id @default(cuid())
  userId                String   @unique
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  monthlyTokenLimit     Int      @default(100000)  // 100k tokens per month
  tokensUsedThisMonth   Int      @default(0)
  monthlyBudgetLimit    Float    @default(10.0)    // $10 per month
  spentThisMonth        Float    @default(0.0)
  resetDate             DateTime @default(now())

  @@index([userId])
}

// Project Model (saved ideas/brainstorms)
model Project {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  title         String
  description   String?
  mode          String   // "brainstorming" or "ideafinder"
  topic         String

  // Brainstorming specific
  brainstormingData BrainstormingData?

  // Ideafinder specific
  ideafinderData IdeafinderData?

  // Shared
  prdContent    String?
  prototypeHtml String?

  // Advanced Features
  isFavorite    Boolean  @default(false)
  templateId    String?
  template      ProjectTemplate? @relation("ProjectTemplate", fields: [templateId], references: [id])
  versions      ProjectVersion[]
  tags          String?  // JSON array of tags

  // Metadata
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  isArchived    Boolean  @default(false)

  // Relations
  sessions      Session[]
  analytics     ProjectAnalytics[]

  @@index([userId])
  @@index([createdAt])
  @@index([isFavorite])
}

// Brainstorming Mode Data
model BrainstormingData {
  id        String   @id @default(cuid())
  projectId String   @unique
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  topic     String
  chatHistory String  // JSON serialized
  prdData   String?  // JSON serialized
  prototypeData String? // JSON serialized

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Ideafinder Mode Data
model IdeafinderData {
  id              String   @id @default(cuid())
  projectId       String   @unique
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  topic           String
  generatedIdeas  String   // JSON serialized array
  selectedIdea    String?  // JSON serialized
  chatHistory     String   // JSON serialized
  prdData         String?  // JSON serialized
  prototypeData   String?  // JSON serialized

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// Session Model (API usage tracking)
model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  sessionType String  // "brainstorm-chat", "ideafinder-generate", etc.
  inputTokens Int     @default(0)
  outputTokens Int    @default(0)
  totalTokens Int     @default(0)
  estimatedCost Float @default(0.0)

  status    String   @default("completed") // "completed", "failed"
  error     String?

  createdAt DateTime @default(now())

  // Relation to cost logs
  costLogs  CostLog[]

  @@index([userId])
  @@index([projectId])
  @@index([createdAt])
}

// Cost Log for tracking spending
model CostLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId String
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  inputTokens Int
  outputTokens Int
  totalTokens Int

  inputCost  Float
  outputCost Float
  totalCost  Float

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

// Refresh Token Model (for JWT rotation)
model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String

  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// Stripe Subscription Model
model Subscription {
  id                    String   @id @default(cuid())
  userId                String   @unique
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  stripeCustomerId      String   @unique
  stripeSubscriptionId  String?  @unique
  stripePriceId         String?
  stripeProductId       String?

  plan                  String   @default("free")   // "free", "pro", "enterprise"
  status                String   @default("active") // "active", "canceled", "past_due"
  currentPeriodStart    DateTime?
  currentPeriodEnd      DateTime?
  cancelAtPeriodEnd     Boolean  @default(false)

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([userId])
  @@index([stripeCustomerId])
}

// Billing History Model
model Billing {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  stripeInvoiceId   String?  @unique
  amount            Float
  currency          String   @default("usd")
  status            String   // "paid", "draft", "open", "void"
  description       String?

  invoicePdfUrl     String?
  createdAt         DateTime @default(now())
  dueDate           DateTime?
  paidAt            DateTime?

  @@index([userId])
  @@index([createdAt])
}

// API Key Model
model APIKey {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  key       String   @unique  // hashed for security
  name      String
  lastUsed  DateTime?
  rateLimit Int      @default(1000) // requests per hour
  isActive  Boolean  @default(true)

  createdAt DateTime @default(now())
  expiresAt DateTime?

  @@index([userId])
  @@index([key])
}

// Project Template Model
model ProjectTemplate {
  id            String   @id @default(cuid())
  name          String
  description   String?
  category      String?  // "saas", "mobile", "ecommerce", etc.

  prdTemplate   String?  // PRD template content
  prototypeCode String?  // Sample prototype code
  defaultStyle  String?  // Default styling preferences

  isPublic      Boolean  @default(false)
  usageCount    Int      @default(0)

  projects      Project[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([category])
}

// Project Version Model (for versioning)
model ProjectVersion {
  id            String   @id @default(cuid())
  projectId     String
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  versionNumber Int
  title         String?
  prdContent    String?
  prototypeHtml String?
  description   String?

  createdAt     DateTime @default(now())

  @@index([projectId])
  @@unique([projectId, versionNumber])
}

// Project Analytics Model
model ProjectAnalytics {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId     String
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  viewCount     Int      @default(0)
  editCount     Int      @default(0)
  exportCount   Int      @default(0)
  totalTokensUsed Int    @default(0)
  totalCost     Float    @default(0.0)

  lastViewedAt  DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
  @@index([projectId])
}

// Notification Settings Model
model NotificationSettings {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  emailOnComplete    Boolean @default(true)
  emailOnQuotaWarning Boolean @default(true)
  emailOnBilling     Boolean @default(true)
  emailWeeklyDigest  Boolean @default(false)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
}
